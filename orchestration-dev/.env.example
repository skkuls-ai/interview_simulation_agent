# ---------- 앱 ----------
APP_NAME=Interview Simulator
APP_VERSION=1.0.0
APP_HOST=127.0.0.1
APP_PORT=8000
DEBUG=TRUE
FRONTEND_ORIGIN=http://localhost:5173

# ---------- Gemini ----------
GEMINI_MODEL=gemini-3.8-flash
# 1) 권장: 학교 Vertex AI 프로젝트 + gcloud 로그인 (API 키 불필요)
GOOGLE_CLOUD_PROJECT=<학교 GCP 프로젝트 ID>
GOOGLE_CLOUD_LOCATION=global
# 2) API 키를 쓰는 경우에만 채움 (Vertex 키라면 GOOGLE_GENAI_USE_VERTEXAI=true 도 추가)
GEMINI_API_KEY=

# ---------- 시뮬레이터 ----------
# 1 이면 꼬리질문 판단에 Gemini 사용, 0 이면 규칙 기반 스텁 (LLM 호출 없음)
INTERVIEW_USE_LLM=1
# 백그라운드 평가(평가자 3명 + 검증)의 동시 호출 수. 429(할당량 초과)가 나면 2로 낮춤
INTERVIEW_BG_LLM_CONCURRENCY=3
# 세션, 결과, 업로드 문서 저장 폴더 (비우면 프로젝트의 var 폴더)
INTERVIEW_DATA_DIR=
