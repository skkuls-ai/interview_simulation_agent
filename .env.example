# 프런트가 mock 데이터를 쓸지. Docker 빌드 기본은 false(서버 연결)이고, 여기에 true를 넣으면 docker compose가 읽어서 mock 프런트가 빌드된다
# VITE_USE_MOCK=false

# LLM (Gemini). 아래 세 가지 중 하나를 고른다 (자세한 설명은 README.md)
# 1) Vertex AI + gcloud 로그인 (컨테이너에서는 불가)
# GOOGLE_CLOUD_PROJECT=
# GOOGLE_CLOUD_LOCATION=global
# 2) Vertex AI API 키
# GOOGLE_GENAI_USE_VERTEXAI=true
# GEMINI_API_KEY=
# 3) Gemini API(AI Studio 키): GEMINI_API_KEY만 넣는다

# 선택: 모델과 추론 수준 (기본 gemini-3.8-flash)
# GEMINI_MODEL=
# INTERVIEW_MODEL_EVALUATOR=
# INTERVIEW_MODEL_COACH=
# INTERVIEW_MODEL_VALIDATOR=
# INTERVIEW_THINKING_EVALUATOR=LOW

# 준비·평가 그래프 모드: auto(키가 있으면 real) | real | fake(shared/mock 재생)
# INTERVIEW_GRAPH_MODE=auto

# 답변 녹음 변환(STT): auto(키가 있으면 gemini) | gemini | stub(고정 텍스트)
# STT_MODE=auto
# STT_MODEL=gemini-3.8-flash
